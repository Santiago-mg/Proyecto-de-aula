# ─── Servidor ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Base de datos PostgreSQL ─────────────────────────────────
# El proyecto usa un PostgreSQL compartido alojado en la máquina de Santiago.
# Cada integrante tiene su propio usuario y contraseña: pídeselos y ponlos aquí.
#
#   HOST = 127.0.0.1        si corres en la misma máquina que la base
#   HOST = IP del equipo    si te conectas por la red/Tailscale
#
DATABASE_URL="postgresql://TU_USUARIO:TU_PASSWORD@HOST:5432/celularpro"

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_aleatoria_segura
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
