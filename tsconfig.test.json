{
  // Las pruebas son TypeScript, pero el tsconfig de producción solo incluye
  // src/ (tiene que hacerlo: rootDir apunta ahí y de ahí sale dist/). Sin
  // esta configuración nadie revisa los tipos de tests/, y Vitest tampoco:
  // transpila con esbuild, que borra los tipos sin comprobarlos. Resultado:
  // una prueba puede quedar desalineada con el dominio —le falta un campo
  // nuevo de una entidad, por ejemplo— y seguir pasando en verde.
  //
  // Esta configuración no emite nada, solo comprueba. La usa `npm run
  // typecheck` junto con la de producción.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts", "vitest.pendiente.config.ts", "vitest.carga.config.ts", "vitest.pendiente-qa.config.ts"],
  // Las pruebas de Mario que esperan código que este back no tiene no
  // compilan hasta que ese código exista (tests/regresion/mario/README.md).
  "exclude": ["tests/regresion/mario/pendiente-codigo-de-mario/**", "tests/escenarios/esc-27-desbanear-usuario-ampliacion.test.ts", "tests/escenarios/esc-28-consultar-usuarios-ampliacion.test.ts", "tests/escenarios/gestion-perfil.test.ts", "tests/fluent/credenciales-y-perfil.test.ts", "tests/regression/regresion-credenciales.test.ts", "tests/rendimiento/rendimiento.test.ts", "tests/seguridad/cabeceras-seguridad.test.ts", "tests/seguridad/fuerza-bruta.test.ts", "tests/seguridad/seguridad-credenciales.test.ts", "tests/unit/gestion-perfil/changePassword.use-case.test.ts", "tests/unit/gestion-perfil/updateProfile.use-case.test.ts", "tests/unit/login/login-enumeracion.test.ts", "tests/unit/validacion-credenciales/login-limiter.middleware.test.ts", "tests/unit/validacion-credenciales/password-policy.test.ts"]
}
