{
  "name": "celular-pro-api",
  "version": "1.0.0",
  "description": "API REST — CelularPro, tienda de celulares certificados",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:regresion": "npm run test:regresion:santiago && npm run test:regresion:mario",
    "test:regresion:santiago": "node tests/regresion/santiago/ejecutar.mjs",
    "test:regresion:mario": "vitest run tests/regresion/mario",
    "test:regresion:funcional": "vitest run tests/regresion/santiago/regression-testing",
    "test:regresion:api": "vitest run tests/regresion/santiago/api-testing",
    "test:regresion:performance": "vitest run tests/regresion/santiago/performance-testing",
    "test:regresion:seguridad": "vitest run tests/regresion/santiago/security-testing",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "metrics": "npm run test:coverage && npm run metrics:duplicacion && npm run metrics:loc",
    "metrics:duplicacion": "npx --yes jscpd src --min-lines 5 --min-tokens 50 --reporters console",
    "metrics:loc": "find src -name '*.ts' -exec wc -l {} + | tail -1",
    "sonar": "npm run test:coverage && npx --yes sonarqube-scanner",
    "verify": "npm run typecheck && npm run test:coverage && npm run metrics:duplicacion",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node-dev --transpile-only src/infrastructure/database/seed.ts",
    "db:studio": "prisma studio",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/escenarios",
    "test:fluent": "vitest run tests/fluent",
    "test:seguridad": "vitest run tests/seguridad",
    "test:rendimiento": "vitest run tests/rendimiento",
    "test:carga": "vitest run --config vitest.carga.config.ts",
    "test:evidencia": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=docs/evidencias/unitarias/resultado.json",
    "instalar": "node scripts/criterios.mjs instalar",
    "criterio1": "node scripts/criterios.mjs 1",
    "criterio2": "node scripts/criterios.mjs 2",
    "criterio3": "node scripts/criterios.mjs 3",
    "criterio4": "node scripts/criterios.mjs 4",
    "criterio5": "node scripts/criterios.mjs 5",
    "criterios": "node scripts/criterios.mjs todos",
    "katalon:servidores": "node scripts/criterios.mjs servidores",
    "rp:simulador": "node reportportal/servidor-simulado.mjs 8089",
    "rp:servidor": "docker compose -f reportportal/docker-compose.yml -p reportportal --profile core --profile analyzer up -d",
    "rp:momentic": "node reportportal/importar-junit.mjs api-momentic/reports/junit.xml api-momentic \"Contrato de la API con Momentic\"",
    "momentic:lint": "npm --prefix api-momentic run lint",
    "momentic:test": "npm --prefix api-momentic test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@reportportal/agent-js-vitest": "5.1.1",
    "@types/autocannon": "^7.12.7",
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "autocannon": "^8.0.0",
    "chai": "^5.3.3",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
