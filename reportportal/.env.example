# Copia este archivo a .env (en la raíz del frontend o exporta las variables en tu shell/CI).
# Sin RP_API_KEY, ninguna suite intenta conectarse a ReportPortal.

# Perfil (arriba a la derecha) → API Keys → Generate API Key
RP_API_KEY=
RP_ENDPOINT=http://localhost:8080/api/v1
RP_PROJECT=celularpro
RP_LAUNCH=CelularPro
# Rama o versión probada: atributo del launch, sirve para comparar ejecuciones
RP_RAMA=local
# true = el agente escribe en consola cada petición (diagnóstico)
RP_DEBUG=false
