# ─────────────────────────────────────────────────────────────────────────────
# Agente de Jenkins de CelularPro (es el mismo archivo en el back y en el front)
#
# Jenkins construye esta imagen y corre cada etapa del pipeline dentro de ella
# (agent { dockerfile ... } en el Jenkinsfile). Así la máquina de Jenkins solo
# necesita Docker: Node, npm, git y el cliente de Docker vienen aquí adentro.
#
# Idea tomada del agente de Andrés (celular-pro-api), con dos cambios:
#   - Parte de la imagen oficial de Node 22 en vez de Ubuntu + nodesource.
#   - No descarga sonar-scanner: el pipeline usa el scanner de npm
#     (npx sonarqube-scanner), que baja el Java que corresponde a la máquina,
#     Intel o Apple Silicon. El zip linux-x64 del agente anterior trae un Java
#     solo para x64.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim

# git: el orquestador lo usa para bajar el backend.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Cliente de Docker y sus plugins (compose y buildx), copiados de la imagen
# oficial. Con el socket del host montado (-v /var/run/docker.sock:...) el
# pipeline puede construir imágenes y levantar contenedores.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:27-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
